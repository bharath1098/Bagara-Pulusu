# Public site origin used for canonical URLs, the sitemap, and Open Graph.
# Example: https://bagarapulusu.example
NEXT_PUBLIC_SITE_URL=

# Staff session cookie signing secret (required in production).
STAFF_SECRET=

# Local dev: leave TURSO_* unset to use data/bagara.db (SQLite file via libSQL).
# Production (Vercel): create a Turso DB and paste credentials here / in Vercel env.

TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-token
